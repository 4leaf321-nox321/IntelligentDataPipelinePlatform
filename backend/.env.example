# 이 파일을 .env 로 복사해서 쓴다. **BOM 없이 UTF-8 로 저장한다** —
# BOM 이 붙으면 첫 줄 키가 조용히 무시된다(app/config.py 주석 참고).
APP_ENV=development
# **DB 는 datarelay 의 것** — 같은 PC 의 SP 개발 DB(standardplatform)를 가리키면 남의 표를 읽고 쓴다.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/datarelay
# 운영에서는 반드시 난수로 바꾼다. 기본값이면 기동을 거부한다.
JWT_SECRET=dev-only-insecure-secret-change-me

# 이 설치가 무슨 플랫폼인가 — 안 적으면 기본값(데이터 중계 · datarelay).
# Vite 개발 서버도 이 파일을 읽어 화면에 같은 값을 심는다.
# APP_SLUG=datarelay
# APP_NAME=데이터 중계
# APP_TAGLINE=
# EXTENSIONS=sample

# 목록 · 통계 읽기의 시간 상한과 그 요청에서만 거는 DB 설정(ADR 0031) — 운영과 같은 기본값이다. 개발 PC 의
# PostgreSQL 서버 설정(공유 버퍼 · 디스크 비용 …)은 `./deploy/pg-tune.sh --url "<DATABASE_URL>"` 로 보고 맞춘다.
# READ_QUERY_SECONDS=60
# READ_WORK_MEM=64MB
# READ_PARALLEL_WORKERS=4
# 임시 파일 상한(ADR 0048) — DB 계정이 그 설정을 바꿀 수 있을 때만 걸린다(개발 PC 의 보통 계정은 못 한다 — 그러면
# 안 건다).
# READ_TEMP_LIMIT=5GB

# 첨부 한 파일의 상한(기본 500MB) — 넘는 업로드는 본문을 받기 전에 413.
# ATTACHMENT_MAX_BYTES=524288000

# 누가 무엇을 보나(ADR 0034) — all(기본): 부서와 상관없이 누구나 전부, department: 전역 + 내 부서만.
# 고치는 것은 어느 쪽이든 소유 부서의 관리자다.
# VIEW_SCOPE=all

# HWAX 포털로 로그인(ADR 0028) — 비우면 꺼진다(콜백이 404 JSON). 운영 값과 까닭은
# deploy/.env.production.example 의 「HWAX 포털에 붙이기」. Vite 개발 서버도 두 값을 보고 단추를 낸다.
# PORTAL_JWKS_URL=http://<포털>:8088/.well-known/jwks.json
# PORTAL_LAUNCH_URL=https://<포털>/launch/<id>
# HWAX 게이트웨이의 사람별 위임(POST /api/auth/sso) — 비우면 꺼진다(404). 개발에서 확인하려면 아무 긴 값.
# HEAX_SSO_SECRET=
# HEAX_SSO_ALLOWED_IPS=

# 중계(relay) — 정의 폴더 · 작업 폴더는 기본값(devtools/ · .work/relay)이면 된다. 비밀은 정의에 적지 않고
# 정의의 token_env 가 가리키는 이름으로 여기(또는 RELAY_SECRETS_FILE)에 둔다.
# MOCK_PLM_TOKEN=mock-plm-token
# RELAY_TARGET_TOKEN=<devtools/sandbox_sp/setup.sh 가 만든 .work/sandbox_sp/relay.token>
# AI(MCP)의 탐색 · 정의 시험이 부를 수 있는 주소(쉼표, host 또는 host:port) — 비우면 개발은 127.0.0.1 · localhost
# 와 사용 중인 정의의 주소. 파일 원천을 읽어도 되는 폴더 — 비우면 개발은 devtools/.
# RELAY_SOURCE_HOSTS=
# RELAY_FILE_ROOTS=
