{
  "format": "relay-pipeline/1",
  "slug": "mock-plm-model",
  "source": "plm",
  "system": "PLM(샘플)",
  "schedule": {
    "daily_at": "01:00"
  },
  "adapter": {
    "kind": "odata",
    "service_url": "http://127.0.0.1:8088/odata/v4/plm",
    "entity_set": "DevModels",
    "key": "ModelId",
    "expand": "Task($expand=Project,TestSite)",
    "modified_field": "UpdatedAt",
    "deleted": "IsDeleted",
    "page_size": 100,
    "auth": {
      "kind": "bearer",
      "token_env": "MOCK_PLM_TOKEN"
    },
    "columns": {
      "MODEL_ID": "ModelId",
      "MODEL_NAME": "ModelName",
      "KIND_CD": "KindCode",
      "REGION": "Region",
      "REVISION": "Revision",
      "BASE_MODEL": "BaseModelId",
      "TASK_CODE": "Task.Code",
      "TASK_NAME": "Task.Name",
      "TASK_STATUS": "Task.StatusCode",
      "SRA_DATE": "Task.SraDate",
      "PROJECT_CODE": "Task.Project.Code",
      "PROJECT_NAME": "Task.Project.Name",
      "SITE_CODE": "Task.TestSite.Code",
      "SITE_NAME": "Task.TestSite.Name",
      "SITE_REGION": "Task.TestSite.Region"
    }
  },
  "recipe": "recipe.table.json",
  "target": {
    "name": "자주검증 Datahub(시험)",
    "server": "http://127.0.0.1:8087",
    "token_env": "RELAY_TARGET_TOKEN"
  }
}
