{
  "format": "relay-pipeline/1",
  "slug": "mock-plm-model-rest",
  "source": "plm",
  "adapter": {
    "kind": "rest",
    "base_url": "http://127.0.0.1:8088",
    "path": "/api/v1/dev-models",
    "rows_path": "items",
    "paging": "page",
    "page_size": 4,
    "since_param": "updated_since",
    "key": "model_id",
    "updated_at": "updated_at",
    "deleted": "deleted",
    "auth": {
      "kind": "bearer",
      "token_env": "MOCK_PLM_TOKEN"
    },
    "columns": {
      "MODEL_ID": "model_id",
      "MODEL_NAME": "model_name",
      "KIND_CD": "kind_cd",
      "REGION": "region",
      "REVISION": "revision",
      "BASE_MODEL": "base_model_id",
      "TASK_CODE": "task.code",
      "TASK_NAME": "task.name",
      "TASK_STATUS": "task.status_cd",
      "SRA_DATE": "task.sra_date",
      "PROJECT_CODE": "task.project.code",
      "PROJECT_NAME": "task.project.name",
      "SITE_CODE": "task.test_site.code",
      "SITE_NAME": "task.test_site.name",
      "SITE_REGION": "task.test_site.region"
    }
  },
  "recipe": "recipe.table.json",
  "target": {
    "name": "jvhubtest",
    "server": "http://127.0.0.1:8087",
    "token_env": "RELAY_TARGET_TOKEN"
  },
  "_note": "REST 판 — 본보기. 지도에는 안 올린다(같은 타입을 두 길로 채우지 않는다)."
}
